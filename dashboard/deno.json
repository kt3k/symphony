{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run -A npm:vite",
    "build": "deno run -A npm:typescript/bin/tsc -b && deno run -A npm:vite build",
    "typecheck": "deno run -A npm:typescript/bin/tsc -b"
  },
  "imports": {
    "@radix-ui/react-progress": "npm:@radix-ui/react-progress@1.1.16",
    "@radix-ui/react-slot": "npm:@radix-ui/react-slot@1.3.3",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@4.3.3",
    "@types/react": "npm:@types/react@19.3.0",
    "@types/react-dom": "npm:@types/react-dom@19.3.0",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@5.2.0",
    "class-variance-authority": "npm:class-variance-authority@0.7.1",
    "clsx": "npm:clsx@2.1.1",
    "lucide-react": "npm:lucide-react@0.544.0",
    "react": "npm:react@19.3.0",
    "react-dom": "npm:react-dom@19.3.0",
    "tailwind-merge": "npm:tailwind-merge@3.7.0",
    "tailwindcss": "npm:tailwindcss@4.3.3",
    "typescript": "npm:typescript@5.9.3",
    "vite": "npm:vite@7.3.6"
  },
  "fmt": {
    "exclude": [
      "dist"
    ]
  },
  "lint": {
    "exclude": [
      "dist"
    ]
  }
}
